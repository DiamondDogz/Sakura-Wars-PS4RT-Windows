#!/usr/bin/env python3
import os, sys, re
sysroot = os.environ.get("MSYS_PREFIX") or os.environ.get("PKG_CONFIG_SYSROOT")
if not sysroot:
    raise SystemExit("Set MSYS_PREFIX to the mingw64 prefix")
paths = os.environ.get("PKG_CONFIG_PATH", sysroot + "/lib/pkgconfig").split(":")

def parse(name, seen=None):
    seen = seen or set()
    if name in seen:
        return {"cflags": [], "libs": [], "version": ""}
    seen.add(name)
    path = None
    for d in paths:
        cand = os.path.join(d, name + ".pc")
        if os.path.isfile(cand):
            path = cand
            break
    if not path:
        raise SystemExit(1)
    vars = {"prefix": sysroot, "pcfiledir": os.path.dirname(path)}
    fields = {}
    for line in open(path, encoding="utf-8", errors="replace"):
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        if ":" not in line and "=" in line:
            k, v = line.split("=", 1)
            k=k.strip()
            val=expand(v.strip(), vars)
            if k=="prefix":
                val=sysroot
            vars[k]=val
            continue
        if ":" in line:
            k, v = line.split(":", 1)
            fields[k.strip()] = expand(v.strip(), vars)
    req = []
    for key in ("Requires", "Requires.private"):
        if fields.get(key):
            for tok in fields[key].replace(",", " ").split():
                tok = tok.split(">")[0].split("<")[0].split("=")[0]
                if tok and not tok.startswith("="):
                    req.append(tok)
    cflags = fields.get("Cflags", "").split()
    libs = fields.get("Libs", "").split()
    for r in req:
        try:
            sub = parse(r, seen)
        except SystemExit:
            continue
        cflags = sub["cflags"] + cflags
        libs = sub["libs"] + libs
    return {"cflags": cflags, "libs": libs, "version": fields.get("Version", "")}

def expand(s, vars):
    for _ in range(10):
        ns = re.sub(r"\$\{(\w+)\}", lambda m: vars.get(m.group(1), ""), s)
        if ns == s:
            break
        s = ns
    if sysroot not in s:
        s = s.replace("/mingw64", sysroot)
    return s

args = sys.argv[1:]
mods = [a for a in args if not a.startswith("-")]
flags = [a for a in args if a.startswith("-")]
if "--exists" in flags:
    for m in mods:
        parse(m)
    sys.exit(0)
outs = []
for m in mods:
    info = parse(m)
    if "--modversion" in flags:
        outs.append(info["version"])
    if "--cflags" in flags or "--cflags-only-I" in flags:
        outs.extend(info["cflags"])
    if "--libs" in flags or "--libs-only-l" in flags or "--static" in flags:
        outs.extend(info["libs"])
print(" ".join(outs))
